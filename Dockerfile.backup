# One-shot backup runner. Install the pinned age implementation separately so
# the runtime contains only the backup scripts and their crypto dependencies.
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-alpine
RUN apk add --no-cache postgresql16-client
WORKDIR /app
COPY --from=deps /app/node_modules/age-encryption ./node_modules/age-encryption
COPY --from=deps /app/node_modules/@noble ./node_modules/@noble
COPY --from=deps /app/node_modules/@scure ./node_modules/@scure
COPY scripts/backup ./scripts/backup
ENV BACKUP_DIR=/backups
ENTRYPOINT ["node", "scripts/backup/scheduled-backup.mjs"]
