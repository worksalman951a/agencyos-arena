# AgencyOS — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit real secrets to Git.

# Database
# PostgreSQL is exposed on host port 5433 (mapped to internal 5432) for A Agent.
# CI and local development both use these values; the app never uses port 3000.
POSTGRES_HOST_PORT=5433
POSTGRES_INTERNAL_PORT=5432
DATABASE_URL="postgresql://agencyos:CHANGE_ME@localhost:${POSTGRES_HOST_PORT:-5433}/agencyos?schema=public"

# Better Auth (see ADR-0001)
# For GitHub Codespaces, set BETTER_AUTH_URL to your forwarded HTTPS URL:
#   BETTER_AUTH_URL=https://<codespace-name>-3001.app.github.dev
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3001"

# Additional trusted origins (comma-separated) for Codespaces forwarded URLs.
# Leave empty for localhost development.
# Example: TRUSTED_ORIGINS="https://curly-lamp-qv47qr54vqj5c96xx-3001.app.github.dev"
TRUSTED_ORIGINS=""

# Next.js
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NODE_ENV="development"
PORT=3001

# App
APP_PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Reverse-proxy trust (Phase 4D / Batch 2 — see docs/phase-4d/csrf-and-rate-limiting.md)
# Set to 1 ONLY when a reverse proxy overwrites X-Forwarded-For with the real
# peer address (nginx: proxy_set_header X-Forwarded-For $remote_addr;).
# When unset, a client-supplied forwarding header is ignored, which is correct
# for direct connections and local development.
TRUST_PROXY_HEADERS=""

# Base URL used by integration tests / Playwright (defaults to BETTER_AUTH_URL, then http://localhost:3001)
TEST_SERVER_URL="http://localhost:3001"
APP_URL="http://localhost:3001"

# Object storage (local dev: local disk; production: S3-compatible after approval)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/uploads"

# Scheduled backups (Phase 4D / Batch 3B — see docs/operations/backup-scheduling-retention.md)
# The schedule itself belongs to the platform (cron, Task Scheduler, a container
# scheduler). This file only configures what one scheduled run does.
BACKUP_DIR="./backups"
# How many verified backups to keep. The newest verified backup is never deleted.
BACKUP_RETENTION_COUNT="7"
# Label recorded in the backup manifest (no secrets).
BACKUP_LABEL="scheduled"
# Optional webhook that receives the structured run result (http/https).
BACKUP_HOOK_URL=""
# Optional bearer token for the webhook. Supply it from the secret manager; it
# is never written to a log or to the result file.
BACKUP_HOOK_TOKEN=""

# Email (Phase 0: interface-only; no credentials required locally)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
