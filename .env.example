# AgencyOS — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit real secrets to Git.

# Database
# PostgreSQL is exposed on host port 5433 (mapped to internal 5432) for A Agent.
# CI and local development both use these values; the app never uses port 3000.
POSTGRES_HOST_PORT=5433
POSTGRES_INTERNAL_PORT=5432
DATABASE_URL="postgresql://agencyos:CHANGE_ME@localhost:${POSTGRES_HOST_PORT:-5433}/agencyos?schema=public"

# Better Auth (see ADR-0001)
# For GitHub Codespaces, set BETTER_AUTH_URL to your forwarded HTTPS URL:
#   BETTER_AUTH_URL=https://<codespace-name>-3001.app.github.dev
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3001"

# Phase 6A automation scheduler. Configure only on the app server and the
# external scheduler; use a random secret of at least 32 characters.
WORKFLOW_SCHEDULER_SECRET=""

# Additional trusted origins (comma-separated) for Codespaces forwarded URLs.
# Leave empty for localhost development.
# Example: TRUSTED_ORIGINS="https://curly-lamp-qv47qr54vqj5c96xx-3001.app.github.dev"
TRUSTED_ORIGINS=""

# Next.js
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NODE_ENV="development"
PORT=3001

# App
APP_PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Reverse-proxy trust (Phase 4D / Batch 2 — see docs/phase-4d/csrf-and-rate-limiting.md)
# Set to 1 ONLY when a reverse proxy overwrites X-Forwarded-For with the real
# peer address (nginx: proxy_set_header X-Forwarded-For $remote_addr;).
# When unset, a client-supplied forwarding header is ignored, which is correct
# for direct connections and local development.
TRUST_PROXY_HEADERS=""

# Base URL used by integration tests / Playwright (defaults to BETTER_AUTH_URL, then http://localhost:3001)
TEST_SERVER_URL="http://localhost:3001"
APP_URL="http://localhost:3001"

# Object storage (local dev: local disk; production: S3-compatible after approval)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/uploads"

# Scheduled backups (Phase 4D / Batch 3B — see docs/operations/backup-scheduling-retention.md)
# The schedule itself belongs to the platform (cron, Task Scheduler, a container
# scheduler). This file only configures what one scheduled run does.
BACKUP_DIR="./backups"
# How many verified backups to keep. The newest verified backup is never deleted.
BACKUP_RETENTION_COUNT="7"
# Label recorded in the backup manifest (no secrets).
BACKUP_LABEL="scheduled"
# Optional webhook that receives the structured run result (http/https).
BACKUP_HOOK_URL=""
# Optional bearer token for the webhook. Supply it from the secret manager; it
# is never written to a log or to the result file.
BACKUP_HOOK_TOKEN=""

# Transactional e-mail (Phase 4D / Batch 4A — see docs/phase-4d/email-delivery.md)
# Also used for password recovery (Batch 4B — see
# docs/phase-4d/password-recovery.md). While delivery is off, a reset request is
# still answered uniformly but no usable link can be sent.
# Off by default: with EMAIL_TRANSPORT empty nothing is sent, no connection is
# opened and no credentials are needed. Local development, the test suites and
# CI run this way; an invitation link is then shown to the administrator only.
# Set EMAIL_TRANSPORT="smtp" to send. Every setting below is then validated, and
# an incomplete or unsafe configuration sends nothing (it never degrades).
EMAIL_TRANSPORT=""

# The SMTP relay. TLS is mandatory and cannot be switched off: port 465 uses TLS
# from the first byte, any other port must upgrade with STARTTLS before anything
# else is sent. Set SMTP_SECURE only if the relay uses implicit TLS on another
# port ("true") or STARTTLS on 465 ("false").
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE=""
# Credentials: set both or neither. Supply them from the secret manager; they
# are never written to a log. If they are set and the relay does not offer
# authentication, sending fails rather than continuing unauthenticated.
# SMTP_USER=""
# SMTP_PASS=""
# Optional: absolute path of a PEM file with the CA that issued the relay's
# certificate, for a private CA. It replaces the system trust store for this
# connection; it cannot disable certificate or host-name verification.
# SMTP_TLS_CA_FILE=""
# Optional: time limit for one delivery attempt in ms (1000-30000, default
# 10000) and attempts per message (1-3, default 2). A message is sent inside the
# request that triggers it, so attempts x timeout bounds how long it can wait.
# SMTP_TIMEOUT_MS="10000"
# SMTP_MAX_ATTEMPTS="2"

# Sender identity. The address must be one the relay is allowed to send as.
# EMAIL_FROM_ADDRESS="no-reply@example.com"
# EMAIL_FROM_NAME="AgencyOS"
# EMAIL_REPLY_TO=""

# Links in a message are built on BETTER_AUTH_URL (or NEXT_PUBLIC_APP_URL), never
# on a request header. With SMTP enabled it must be the https:// origin of the
# application; http:// is accepted for localhost only.
