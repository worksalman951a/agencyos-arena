generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// ============================================
/// Better Auth models (expected by better-auth)
/// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  password      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // AgencyOS extensions
  organizationId String?
  role           String    @default("employee")
  status         String    @default("active")
  /// "internal" (team member) or "client" (client-portal identity).
  ///
  /// Client identities are created only by accepting a ClientInvitation. They
  /// have no organization membership and no UserRole rows, so every internal
  /// authorization path (requireOrganization / RBAC) rejects them by
  /// construction. See lib/portal/access-control.ts.
  userType       String    @default("internal")
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  lastLoginAt    DateTime?

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userRoles     UserRole[]
  sessions      Session[]
  accounts      Account[]
  verifications Verification[]
  auditLogs     AuditLog[]

  createdContacts         Contact[]                @relation("CreatedContact")
  updatedContacts         Contact[]                @relation("UpdatedContact")
  createdProposals        Proposal[]               @relation("CreatedProposal")
  updatedProposals        Proposal[]               @relation("UpdatedProposal")
  createdQuotations       Quotation[]              @relation("CreatedQuotation")
  updatedQuotations       Quotation[]              @relation("UpdatedQuotation")
  createdInvoices         Invoice[]                @relation("CreatedInvoice")
  updatedInvoices         Invoice[]                @relation("UpdatedInvoice")
  createdWorkflowRules    WorkflowRule[]           @relation("WorkflowRuleCreator")
  createdProjects         Project[]                @relation("CreatedProject")
  updatedProjects         Project[]                @relation("UpdatedProject")
  createdPayments         Payment[]                @relation("CreatedPayment")
  signedContracts         Contract[]
  timeEntries             TimeEntry[]
  projectFiles            ProjectFile[]
  tasks                   Task[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  createdApprovals        ProjectApproval[]        @relation("CreatedProjectApproval")
  taskComments            TaskComment[]
  proposalVersions        ProposalVersion[]        @relation("CreatedProposalVersion")
  documentVersions        DocumentVersion[]        @relation("CreatedDocumentVersion")
  documentLinks           DocumentLink[]           @relation("CreatedDocumentLink")

  // Client portal
  clientAccess             ClientAccess?
  sentClientInvitations    ClientInvitation[]    @relation("ClientInvitationInviter")
  sharedClientGrants       ClientResourceGrant[] @relation("ClientGrantSharer")
  requestedClientApprovals ClientApproval[]      @relation("ClientApprovalRequester")
  respondedClientApprovals ClientApproval[]      @relation("ClientApprovalResponder")
  clientApprovalEvents     ClientApprovalEvent[] @relation("ClientApprovalEventActor")
  clientComments           ClientComment[]       @relation("ClientCommentAuthor")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ============================================
/// AgencyOS Core / Platform
/// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  agencyAccounts          AgencyAccount[]
  contacts                Contact[]
  organizations           OrganizationAccount[]
  leads                   Lead[]
  opportunities           Opportunity[]
  pipelines               Pipeline[]
  projects                Project[]
  projectTemplates        ProjectTemplate[]
  invoices                Invoice[]
  estimates               Estimate[]
  expenseItems            ExpenseItem[]
  proposals               Proposal[]
  quotations              Quotation[]
  contracts               Contract[]
  documents               Document[]
  tasks                   Task[]
  timeEntries             TimeEntry[]
  projectFiles            ProjectFile[]
  milestones              Milestone[]
  changeOrders            ChangeOrder[]
  workflowRules           WorkflowRule[]
  workflowExecutions      WorkflowExecution[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  customFields            CustomField[]
  roles                   Role[]
  userRoles               UserRole[]
  featureFlags            FeatureFlag[]
  fileAssets              FileAsset[]
  webhookEvents           WebhookEvent[]
  projectApprovals        ProjectApproval[]
  taskComments            TaskComment[]
  proposalVersions        ProposalVersion[]
  documentVersions        DocumentVersion[]
  documentLinks           DocumentLink[]
  signatures              Signature[]

  // Client portal
  clientAccesses       ClientAccess[]
  clientInvitations    ClientInvitation[]
  clientGrants         ClientResourceGrant[]
  clientApprovals      ClientApproval[]
  clientApprovalEvents ClientApprovalEvent[]
  clientComments       ClientComment[]
}

model OrganizationAccount {
  id             String   @id @default(cuid())
  organizationId String
  accountId      String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      AgencyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, accountId])
}

model AgencyAccount {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  website        String?
  address        String?
  status         String    @default("active")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  organizations   OrganizationAccount[]
  opportunities   Opportunity[]
  accountContacts AccountContact[]
  leads           Lead[]
}

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]
  invitations  Invitation[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  assignedAt     DateTime @default(now())
  assignedBy     String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
}

/// Audit log
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorName      String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

/// Custom fields
model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  fieldName      String
  fieldType      String
  config         Json     @default("{}")
  isRequired     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]
}

model CustomFieldValue {
  id            String   @id @default(cuid())
  customFieldId String
  entityId      String
  value         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
}

/// Feature flags
model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  flagKey        String   @unique
  enabled        Boolean  @default(false)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Webhook events
model WebhookEvent {
  id             String    @id @default(cuid())
  organizationId String
  eventType      String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// File assets (metadata only)
model FileAsset {
  id             String   @id @default(cuid())
  organizationId String
  originalName   String
  mimeType       String
  size           Int
  storagePath    String
  uploadedBy     String?
  createdAt      DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectFiles     ProjectFile[]
  documents        Document[]
  documentVersions DocumentVersion[]
}

/// ============================================
/// CRM
/// ============================================

model Contact {
  id             String    @id @default(cuid())
  organizationId String
  accountId      String?
  firstName      String?
  lastName       String
  email          String?
  phone          String?
  maskedEmail    String?
  maskedPhone    String?
  isMasked       Boolean   @default(false)
  status         String    @default("active")
  source         String?
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account          AgencyAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountContacts  AccountContact[]
  leads            Lead[]
  opportunities    Opportunity[]
  proposals        Proposal[]
  quotations       Quotation[]
  invoices         Invoice[]
  projects         Project[]
  creator          User?             @relation("CreatedContact", fields: [createdBy], references: [id], onDelete: SetNull)
  updater          User?             @relation("UpdatedContact", fields: [updatedBy], references: [id], onDelete: SetNull)
  projectApprovals ProjectApproval[]

  // Client portal: a CRM contact is the client identity a portal login is bound to.
  clientAccesses    ClientAccess[]
  clientInvitations ClientInvitation[]
}

model AccountContact {
  id            String   @id @default(cuid())
  accountId     String
  contactId     String
  roleInAccount String?
  createdAt     DateTime @default(now())

  account AgencyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([accountId, contactId])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  contactId      String?
  accountId      String?
  source         String
  status         String    @default("new")
  priority       String?
  expectedValue  Decimal?
  ownerId        String?
  pipelineId     String?
  stageId        String?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account       AgencyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  pipeline      Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage         PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
}

model Pipeline {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isDefault      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  leads         Lead[]
  opportunities Opportunity[]
}

model PipelineStage {
  id          String    @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  color       String?
  probability Decimal?
  isWon       Boolean   @default(false)
  isLost      Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads         Lead[]
  opportunities Opportunity[]
}

model Opportunity {
  id             String    @id @default(cuid())
  organizationId String
  contactId      String?
  accountId      String?
  leadId         String?
  pipelineId     String?
  stageId        String?
  title          String
  description    String?
  value          Decimal?
  currency       String    @default("USD")
  closeDate      DateTime?
  ownerId        String?
  status         String    @default("open")
  probability    Decimal?
  lossReason     String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account      AgencyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  pipeline     Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage        PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  proposals    Proposal[]
  quotations   Quotation[]
}

/// ============================================
/// Finance (partial - invoices, payments, estimates, expenses)
/// ============================================

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  title          String
  clientId       String?
  projectId      String?
  status         String    @default("draft")
  subtotal       Decimal   @default(0)
  tax            Decimal   @default(0)
  total          Decimal   @default(0)
  currency       String    @default("USD")
  dueDate        DateTime?
  notes          String?
  deletedAt      DateTime?
  idempotencyKey String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Contact?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]
  creator      User?         @relation("CreatedInvoice", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?         @relation("UpdatedInvoice", fields: [updatedBy], references: [id], onDelete: SetNull)
  // Optional project link (Phase 5A). The foreign key is COMPOSITE on purpose:
  // it references Project(id, organizationId) using this invoice's own
  // organizationId, so PostgreSQL itself rejects a project that belongs to
  // another organization - whoever writes the row. NoAction (never Cascade or
  // SetNull): a project that still has invoices cannot be hard-deleted, and a
  // financial record is never removed or silently detached by a project
  // deletion. See docs/phase-5a/project-invoice-linking.md.
  project      Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)

  // Invoice numbers are unique per organization. The allocator already
  // serialises on the organization row; this index is the database guarantee
  // for numbers written outside the allocator (imports, manual SQL).
  // Payment idempotency keys are additionally protected by the partial unique
  // index created in migration 0015, which Prisma cannot express.
  @@unique([organizationId, number])
  // Project workspace listing / project filter, and the referential check that
  // runs when a project row is deleted.
  @@index([organizationId, projectId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal
  unitPrice   Decimal
  taxRate     Decimal  @default(0)
  amount      Decimal
  createdAt           DateTime @default(now())
  sourceExpenseId     String?  @unique
  sourceChangeOrderId String?  @unique

  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceExpense       ExpenseItem?  @relation("ExpenseBillingSource", fields: [sourceExpenseId], references: [id], onDelete: NoAction)
  sourceChangeOrder   ChangeOrder?  @relation("ChangeOrderBillingSource", fields: [sourceChangeOrderId], references: [id], onDelete: NoAction)
}

model Payment {
  id             String   @id @default(cuid())
  invoiceId      String
  amount         Decimal
  method         String   @default("bank_transfer")
  reference      String?
  paidAt         DateTime
  recordedBy     String?
  idempotencyKey String?
  createdAt      DateTime @default(now())

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recorder User?   @relation("CreatedPayment", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Estimate {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  status         String    @default("draft")
  total          Decimal   @default(0)
  currency       String    @default("USD")
  validUntil     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ExpenseItem {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  category       String
  amount         Decimal
  expenseDate    DateTime
  receiptUrl     String?
  billable       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billedInvoiceItem InvoiceItem? @relation("ExpenseBillingSource")

  @@index([organizationId, projectId, expenseDate])
}

/// ============================================
/// Projects & Delivery
/// ============================================

model Project {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  description    String?
  status         String    @default("active")
  budget         Decimal?
  startDate      DateTime?
  endDate        DateTime?
  templateId     String?
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Contact?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  creator      User?             @relation("CreatedProject", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?             @relation("UpdatedProject", fields: [updatedBy], references: [id], onDelete: SetNull)
  template     ProjectTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks        Task[]
  milestones   Milestone[]
  changeOrders ChangeOrder[]
  files        ProjectFile[]
  approvals    ProjectApproval[]
  contracts    Contract[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]

  // Target of composite Project foreign keys (Invoice -> Project, TimeEntry -> Project).
  // `id` is already the primary key, so this adds no new restriction on projects;
  // it only lets a child row prove "same organization" at the database level.
  @@unique([id, organizationId])
}

model ProjectTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  assigneeId     String?
  milestoneId    String?
  title          String
  status         String    @default("todo")
  priority       String    @default("medium")
  dueDate        DateTime?
  estimatedHours Decimal?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timeEntries  TimeEntry[]
  projectFiles ProjectFile[]
  comments     TaskComment[]
}

model Milestone {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  dueDate        DateTime?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  projectId      String?
  taskId         String?
  date           DateTime
  hours          Decimal
  description    String?
  billable       Boolean  @default(false)
  hourlyRate     Decimal?
  currency       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@index([organizationId, userId, date])
}

model ProjectFile {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String?
  fileAssetId    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset    @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
}

model ChangeOrder {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  description    String
  amount         Decimal
  status         String   @default("pending")
  approvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  billedInvoiceItem InvoiceItem? @relation("ChangeOrderBillingSource")

  @@index([organizationId, projectId, status])
}

/// ============================================
/// Automation & Communication
/// ============================================

model WorkflowRule {
  id             String   @id @default(cuid())
  organizationId String
  createdBy      String?
  name           String
  trigger        String
  conditions     Json     @default("{}")
  actions        Json     @default("{}")
  enabled        Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?               @relation("WorkflowRuleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  executions   WorkflowExecution[]

  @@index([organizationId, trigger, enabled])
  @@index([createdBy])
}

/// Execution history for a workflow rule.
///
/// `dedupeKey` is the duplicate-execution guard: one execution per
/// (rule, record, dedupe key). It is a stored column with a unique constraint
/// rather than a checked-then-inserted predicate, so two concurrent
/// evaluations of the same event cannot both execute.
model WorkflowExecution {
  id             String    @id @default(cuid())
  organizationId String
  ruleId         String
  recordType     String
  recordId       String
  status         String    @default("pending")
  resultLog      Json?
  /// Nullable: executions recorded without a dedupe key keep their old behaviour.
  dedupeKey      String?
  /// Number of attempts made, for retry bookkeeping.
  attempts       Int       @default(0)
  /// When the last attempt ran.
  lastAttemptAt  DateTime?
  /// Earliest time a bounded retry may claim this execution.
  nextAttemptAt  DateTime?
  /// Set for terminal failures or quarantined executions.
  terminalAt     DateTime?
  /// Sanitized operational category, never an exception message.
  errorCategory  String?
  /// Fences a worker that lost its stale lease from finalizing a newer attempt.
  claimToken     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, recordType, recordId, dedupeKey])
  @@index([organizationId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, lastAttemptAt])
  @@index([status, errorCategory, updatedAt])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  channel        String
  read           Boolean   @default(false)
  payload        Json?
  sentAt         DateTime?
  /// Duplicate-notification guard: one notification per
  /// (user, type, dedupe key) inside an organization.
  dedupeKey      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, type, dedupeKey])
  @@index([organizationId, userId, read])
}

/// Per-user notification preferences.
///
/// Missing row = platform defaults. `channels` maps a channel name
/// ("in_app", "email") to whether it is enabled; `mutedTypes` lists
/// notification `type` values the user never wants to receive.
model NotificationPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  channels       Json     @default("{}")
  mutedTypes     String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

/// Organization membership invitations.
///
/// Only the SHA-256 hash of the invitation token is stored: a database leak
/// must not hand out usable invitations. The raw token exists once, in the
/// response to the administrator who created it.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  tokenHash      String    @unique
  status         String    @default("pending")
  expiresAt      DateTime
  invitedBy      String?
  acceptedAt     DateTime?
  acceptedBy     String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([organizationId, status])
}

/// Documents — Proposals & Quotations (Phase 2.1)

model Proposal {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  opportunityId  String?
  contactId      String?
  title          String
  status         String    @default("draft")
  subtotal       Decimal   @default(0)
  tax            Decimal   @default(0)
  total          Decimal   @default(0)
  currency       String    @default("USD")
  validUntil     DateTime?
  notes          String?
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items        ProposalLineItem[]
  versions     ProposalVersion[]
  creator      User?              @relation("CreatedProposal", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?              @relation("UpdatedProposal", fields: [updatedBy], references: [id], onDelete: SetNull)
  contracts    Contract[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model ProposalLineItem {
  id          String   @id @default(cuid())
  proposalId  String
  description String
  quantity    Decimal
  unitPrice   Decimal
  taxRate     Decimal  @default(0)
  amount      Decimal
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sortOrder])
}

model Quotation {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  opportunityId  String?
  contactId      String?
  title          String
  status         String    @default("draft")
  subtotal       Decimal   @default(0)
  tax            Decimal   @default(0)
  total          Decimal   @default(0)
  currency       String    @default("USD")
  validUntil     DateTime?
  notes          String?
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items        QuotationLineItem[]
  creator      User?               @relation("CreatedQuotation", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?               @relation("UpdatedQuotation", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model QuotationLineItem {
  id          String   @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal
  unitPrice   Decimal
  taxRate     Decimal  @default(0)
  amount      Decimal
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, sortOrder])
}

model Contract {
  id                 String    @id @default(cuid())
  organizationId     String
  proposalId         String?
  projectId          String?
  title              String
  status             String    @default("draft")
  signatureReference String?
  signedAt           DateTime?
  signedBy           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  signer       User?        @relation(fields: [signedBy], references: [id], onDelete: SetNull)
  signatures   Signature[]
}

model Document {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  type           String
  folder         String?
  visibility     String   @default("private")
  fileAssetId    String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset?        @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  versions     DocumentVersion[]
  links        DocumentLink[]
  signatures   Signature[]
}

model ProposalVersion {
  id             String   @id @default(cuid())
  organizationId String
  proposalId     String
  version        Int
  title          String
  status         String
  subtotal       Decimal  @default(0)
  tax            Decimal  @default(0)
  total          Decimal  @default(0)
  currency       String   @default("USD")
  notes          String?
  snapshot       Json
  createdAt      DateTime @default(now())
  createdBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  creator      User?        @relation("CreatedProposalVersion", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([proposalId, version])
}

model DocumentVersion {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  version        Int
  title          String
  fileAssetId    String?
  snapshot       Json?
  createdAt      DateTime @default(now())
  createdBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset?   @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  creator      User?        @relation("CreatedDocumentVersion", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([documentId, version])
}

model DocumentLink {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  token          String   @unique
  expiresAt      DateTime
  accessCount    Int      @default(0)
  maxAccess      Int?
  createdAt      DateTime @default(now())
  createdBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator      User?        @relation("CreatedDocumentLink", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([expiresAt])
}

model Signature {
  id                 String   @id @default(cuid())
  organizationId     String
  documentId         String?
  contractId         String?
  signerName         String
  signerEmail        String
  signedAt           DateTime @default(now())
  signatureMethod    String   @default("audit_trail") // audit_trail | esign_provider
  signatureReference String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  contract     Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
}

model ProjectApproval {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  contactId      String?
  status         String    @default("pending") // pending, approved, changes_requested
  feedback       String?
  approvedAt     DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  creator      User?        @relation("CreatedProjectApproval", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model TaskComment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  userId         String
  comment        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// ============================================
/// Client Portal (Phase 4C)
/// ============================================
///
/// Design notes
/// - A client identity is a `User` with `userType = "client"`, **no**
///   `organizationId` and **no** `UserRole` rows. Internal authorization
///   (organization membership + RBAC) therefore rejects client sessions by
///   construction instead of relying on a negative permission list.
/// - Visibility is an explicit allow-list: a client sees a resource only when a
///   `ClientResourceGrant` names it. Holding an internal record id grants
///   nothing.
/// - Approvals recorded here keep the responding identity and an append-only
///   event history. These are *not* legally certified e-signatures; the
///   existing `Signature` audit trail is untouched and remains internal.

/// One portal login per client contact (per organization).
model ClientAccess {
  id             String  @id @default(cuid())
  organizationId String
  /// Exactly one portal identity per user, so session resolution is unambiguous.
  userId         String  @unique
  contactId      String
  accountId      String?
  /// active | suspended | revoked
  status         String  @default("active")
  /// Informational label only; capabilities come from the flags below, never
  /// from this string.
  role           String  @default("client_viewer")

  // Configurable capabilities. Defaults are least-privilege.
  canViewInvoices  Boolean @default(false)
  canDownloadFiles Boolean @default(false)
  canComment       Boolean @default(false)
  canApprove       Boolean @default(false)

  invitedBy    String?
  suspendedAt  DateTime?
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  grants    ClientResourceGrant[]
  approvals ClientApproval[]
  comments  ClientComment[]

  @@unique([organizationId, contactId])
  @@index([organizationId, status])
}

/// Client portal invitation.
///
/// Only the SHA-256 hash of the token is stored; the raw token is returned once
/// to the administrator who created it. Mirrors the organization `Invitation`
/// security properties but never grants organization membership or a role.
/// Client-portal invitation issued by an administrator.
///
/// "At most one live invitation per organization and recipient" is enforced by
/// the partial unique index `ClientInvitation_pending_org_email_key`
/// (migration `0020`), not by this file: Prisma cannot express a partial index.
/// The predicate is `status = 'pending'`, so accepted, revoked and expired
/// invitations never block a replacement. Do not add a plain
/// `@@unique([organizationId, email])` - it would forbid re-inviting after
/// acceptance or revocation. See docs/phase-4d/client-invitation-concurrency.md.
model ClientInvitation {
  id             String  @id @default(cuid())
  organizationId String
  email          String
  contactId      String
  accountId      String?
  tokenHash      String  @unique
  /// pending | accepted | revoked
  status         String  @default("pending")

  role             String  @default("client_viewer")
  canViewInvoices  Boolean @default(false)
  canDownloadFiles Boolean @default(false)
  canComment       Boolean @default(false)
  canApprove       Boolean @default(false)

  expiresAt        DateTime
  invitedBy        String?
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("ClientInvitationInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([organizationId, status])
}

/// Explicit share of one internal resource with one client.
///
/// `resourceType` is validated in `lib/portal/resource-registry.ts`; a grant for
/// a type the portal cannot render is rejected rather than silently ignored.
model ClientResourceGrant {
  id             String @id @default(cuid())
  organizationId String
  clientAccessId String
  /// project | document | proposal | quotation | estimate | contract | invoice | file
  resourceType   String
  resourceId     String

  canComment Boolean @default(false)
  canApprove Boolean @default(false)
  note       String?

  sharedBy  String?
  sharedAt  DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccess ClientAccess @relation(fields: [clientAccessId], references: [id], onDelete: Cascade)
  sharer       User?        @relation("ClientGrantSharer", fields: [sharedBy], references: [id], onDelete: SetNull)

  @@unique([clientAccessId, resourceType, resourceId])
  @@index([organizationId, resourceType, resourceId])
  @@index([clientAccessId, revokedAt])
}

/// A client-facing approval request (proof / document / project deliverable).
///
/// Distinct from `ProjectApproval`, which stays the internal-only approval
/// record: this one is bound to a client identity, requires an explicit grant on
/// the resource, and carries its own immutable event history.
model ClientApproval {
  id             String  @id @default(cuid())
  organizationId String
  clientAccessId String
  resourceType   String
  resourceId     String
  title          String
  description    String?
  /// pending | approved | changes_requested | cancelled
  status         String  @default("pending")

  dueAt        DateTime?
  requestedBy  String?
  respondedBy  String?
  respondedAt  DateTime?
  responseNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccess ClientAccess          @relation(fields: [clientAccessId], references: [id], onDelete: Cascade)
  requester    User?                 @relation("ClientApprovalRequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  responder    User?                 @relation("ClientApprovalResponder", fields: [respondedBy], references: [id], onDelete: SetNull)
  events       ClientApprovalEvent[]

  @@index([organizationId, status])
  @@index([clientAccessId, status])
  @@index([organizationId, resourceType, resourceId])
}

/// Append-only approval history (who did what, when, from which side).
model ClientApprovalEvent {
  id             String   @id @default(cuid())
  organizationId String
  approvalId     String
  /// internal | client | system
  actorType      String
  actorUserId    String?
  /// requested | approved | changes_requested | cancelled | commented
  action         String
  note           String?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approval     ClientApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actor        User?          @relation("ClientApprovalEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([approvalId, createdAt])
}

/// Feedback on a shared resource.
///
/// `visibility` separates internal team notes from client-visible conversation:
/// a client only ever reads `client` rows on resources it was granted, and can
/// only ever write `client` rows.
model ClientComment {
  id             String   @id @default(cuid())
  organizationId String
  /// Null only if the client access was deleted afterwards (SetNull below).
  clientAccessId String?
  resourceType   String
  resourceId     String
  authorUserId   String
  /// internal | client
  authorType     String
  /// client | internal
  visibility     String
  body           String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccess ClientAccess? @relation(fields: [clientAccessId], references: [id], onDelete: SetNull)
  author       User          @relation("ClientCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType, resourceId, createdAt])
  @@index([clientAccessId, createdAt])
}

/// Shared rate-limit counter for AgencyOS' own API routes (lib/security/rate-limit.ts).
///
/// Better Auth's limiter only sees `/api/auth/*`, and an in-memory counter is
/// per process, so this table is the deployment-wide bucket store: one atomic
/// upsert per request keeps several Node instances on the same budget.
///
/// Rows are safe to delete once `expiresAt` has passed; the upsert reuses a row
/// whose window has elapsed instead of deleting it, so the table only grows with
/// distinct keys and stays small.
model RateLimitBucket {
  /// Opaque policy-qualified key, e.g. "invitation-accept:<sha256 prefix>".
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}
